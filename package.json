{
  "name": "@ahmetkca/missionplanner-mcp-server",
  "version": "0.1.1",
  "description": "MCP server for ArduPilot Mission Planner — exposes vehicle parameters to AI coding agents",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "missionplanner-mcp-server": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http --port 9990",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["mcp", "ardupilot", "mission-planner", "mavlink", "model-context-protocol", "ai-agent"],
  "author": "Ahmet Karapinar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetkca/missionplanner-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ahmetkca/missionplanner-mcp-server/issues"
  },
  "homepage": "https://github.com/ahmetkca/missionplanner-mcp-server#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
